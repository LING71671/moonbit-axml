{
  "name": "axml-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare.mjs && node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
